# Every variable is set on the server in .env; values are never committed.
# Root of occurrence directories, e.g. /srv/tolongmeeting/data
TM_DATA_ROOT=
# Root of identity profiles on the encrypted volume, e.g. /srv/tolongmeeting/profiles
TM_PROFILE_ROOT=
# Set by compose to the Docker secret /run/secrets/tm_master_key (32 bytes, base64)
TM_MASTER_KEY_FILE=
# The website's base URL, e.g. https://tm.example (no trailing slash)
TM_PUBLIC_URL=
# postgres://tm:<password>@postgres:5432/tm (URL-encode the password)
DATABASE_URL=
# The password of the Postgres user `tm`; compose only, and the same one as in DATABASE_URL
POSTGRES_PASSWORD=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ORG=
# Set by compose to http://docker-proxy:2375
DOCKER_PROXY_URL=
# ntfy base URL, e.g. https://ntfy.tm.example (no trailing slash), and the ntfy admin user's token
NTFY_URL=
NTFY_ADMIN_TOKEN=
# rclone crypt remote for nightly backups, e.g. tm-backup:
TM_BACKUP_REMOTE=
# Whether the server's own identities may watch a chat app (spike 7 has not run, so the defaults stay).
# Leave both lines out to use them; an empty value is an error. WhatsApp: allowed, home_only (default) or none.
# TM_WHATSAPP_FROM_SERVER=home_only
# Discord: allowed (default) or home_only.
# TM_DISCORD_FROM_SERVER=allowed
# Plan 08. The registry reference of the worker image that a paired PC pulls, e.g. ghcr.io/<org>/tolongmeeting-worker:<version>
# (the same build the server runs). Read when a member uses My PC; no default.
TM_WORKER_IMAGE_REF=
# Plan 08. Tailscale OAuth client of the home route (scopes: devices:core read, auth_keys write). Read when a member
# uses the home route; no default. Leave a line empty or out of .env and the feature fails loudly when it is used.
TM_TAILSCALE_CLIENT_ID=
TM_TAILSCALE_CLIENT_SECRET=
# The tailnet name; leave the line out to use "-" (the tailnet of the OAuth client).
# TM_TAILSCALE_TAILNET=-
# TM_PROFILE_KEY_FILE is set per container by the launcher, never here.
