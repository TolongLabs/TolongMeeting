[Unit]
Description=TolongMeeting worker network egress rules
# Before Docker, so no worker can start while the rules are missing; docker.service.d/10-tm-egress.conf makes Docker
# require this unit, so a failed script keeps Docker (and every worker) down.
Before=docker.service
After=network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/tm-worker-egress.sh

[Install]
WantedBy=multi-user.target
