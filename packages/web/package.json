{
  "name": "@tm/web",
  "private": true,
  "type": "module",
  "exports": {
    "./db": "./db/index.ts",
    "./db/*": "./db/*.ts",
    "./lib/*": "./lib/*.ts"
  },
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
