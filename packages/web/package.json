    "db:migrate": "bun db/migrate.ts",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@tm/ai": "workspace:*",
    "@tm/core": "workspace:*",
    "better-auth": "^1.7.11",
    "drizzle-orm": "0.45.4",
    "next": "16.4.2",
    "pg": "8.23.1",
    "pg-boss": "^12.38.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "drizzle-kit": "0.31.11"
  }
}
