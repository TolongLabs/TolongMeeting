{
  "tagOwners": {
    "tag:tm-home": ["autogroup:admin"],
    "tag:tm-worker": ["autogroup:admin"]
  },
  "acls": [{ "action": "accept", "src": ["tag:tm-worker"], "dst": ["autogroup:internet:*"] }],
  "autoApprovers": {
    "exitNode": ["tag:tm-home"]
  },
  "tests": [
    {
      "src": "tag:tm-worker",
      "deny": ["tag:tm-worker:*", "tag:tm-home:*"]
    },
    {
      "src": "tag:tm-home",
      "deny": ["tag:tm-home:*", "tag:tm-worker:*"]
    }
  ]
}
