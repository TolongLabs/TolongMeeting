  "cards": [
    {
      "dot": "cyan",
      "title": "One screen, two halves",
      "items": [
        "Xvfb 3840x1080 with openbox: stage on the left, desk on the right, never overlapping",
        "Only the stage is recorded, scanned for QR codes and used for slides",
        "Chat watchers, form tabs and the sign-in view stay on the unrecorded desk"
      ]
    },
    {
      "dot": "emerald",
      "title": "Capture",
      "items": [
        "ffmpeg grabs the stage and the PulseAudio sink into 5-minute attempt_N_seg_NNN.mkv segments, 1920x1080 at 15 fps",
        "The frame loop saves a stage frame every 2 s for QR decoding and slide keyframes",
        "Live mode streams the sink's audio to DashScope; results are timestamped by stream offset"
      ]
    },
    {
      "dot": "amber",
      "title": "Control",
      "items": [
        "A heartbeat every 5 s carries state, recording status and events; the reply carries commands",
        "pause_for_signin hands the desk to the member's remote view; resume_after_signin takes it back",
        "Files are written incrementally, so a crash loses a few seconds at most"
      ]
    }
  ]
