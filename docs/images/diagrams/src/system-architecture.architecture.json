  "cards": [
    {
      "dot": "cyan",
      "title": "Server",
      "items": [
        "Caddy fronts the website, ntfy and the noVNC WebSocket",
        "The scheduler launches workers only through the restricted Docker socket proxy",
        "At most 2 server workers run at once"
      ]
    },
    {
      "dot": "emerald",
      "title": "Worker container",
      "items": [
        "Stage is recorded; desk (chat watchers, forms, sign-in) is not",
        "The worker sends a heartbeat every 5 s and writes its files to the occurrence directory"
      ]
    },
    {
      "dot": "amber",
      "title": "Run locations",
      "items": [
        "Server, server through the home exit node, or the member's PC",
        "On the PC the companion app runs the same worker image and relays its control channel"
      ]
    }
  ]
