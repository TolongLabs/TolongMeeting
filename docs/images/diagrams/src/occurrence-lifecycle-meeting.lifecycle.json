{
  "schema_version": 2,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "Meeting Occurrence: Joining to Leaving",
    "output": ".archify/occurrence-lifecycle-meeting/occurrence-lifecycle-meeting.html",
    "quality_profile": "showcase",
    "legend": {
      "mode": "hidden"
    }
  },
  "lanes": [
    {
      "id": "main",
      "label": "In the meeting"
    },
    {
      "id": "side",
      "label": "Restart"
    },
    {
      "id": "terminal",
      "label": "Ends here"
    }
  ],
  "states": [
    {
      "id": "joining",
      "type": "external",
      "label": "Joining",
      "sublabel": "from the previous diagram",
      "lane": "main",
      "col": 0
    },
    {
      "id": "in_lobby",
      "type": "waiting",
      "label": "In lobby",
      "sublabel": "knocks again, at most 2",
      "lane": "main",
      "col": 1,
      "width": 160
    },
    {
      "id": "in_meeting",
      "type": "active",
      "label": "In meeting",
      "sublabel": "recording, watching",
      "lane": "main",
      "col": 2
    },
    {
      "id": "leaving",
      "type": "active",
      "label": "Leaving",
      "sublabel": "meeting ended",
      "lane": "main",
      "col": 3
    },
    {
      "id": "uploading",
      "type": "external",
      "label": "Uploading",
      "sublabel": "next diagram",
      "lane": "main",
      "col": 4
    },
    {
      "id": "restarting",
      "type": "waiting",
      "label": "Restarting",
      "sublabel": "previous state resumes",
      "lane": "side",
      "col": 2,
      "width": 160
    },
    {
      "id": "denied",
      "type": "failure",
      "label": "Denied",
      "sublabel": "host refused entry",
      "lane": "terminal",
      "col": 1
    },
    {
      "id": "left_by_member",
      "type": "neutral",
      "label": "Left by member",
      "sublabel": "leave_now or take_over",
      "lane": "terminal",
      "col": 3,
      "width": 160
    },
    {
      "id": "failed",
      "type": "failure",
      "label": "Failed",
      "sublabel": "from any state, with reason",
      "lane": "terminal",
      "col": 4,
      "width": 160
    }
  ],
  "transitions": [
    {
      "id": "joining-to-in_lobby",
      "from": "joining",
      "to": "in_lobby",
      "label": "lobby"
    },
    {
      "id": "joining-to-in_meeting",
      "from": "joining",
      "to": "in_meeting",
      "label": "no lobby",
      "variant": "emphasis",
      "route": "top-channel"
    },
    {
      "id": "in_lobby-to-in_meeting",
      "from": "in_lobby",
      "to": "in_meeting",
      "label": "admitted",
      "variant": "emphasis"
    },
    {
      "id": "in_lobby-to-denied",
      "from": "in_lobby",
      "to": "denied",
      "label": "denied",
      "variant": "security"
    },
    {
      "id": "in_meeting-to-leaving",
      "from": "in_meeting",
      "to": "leaving",
      "label": "meeting over",
      "variant": "emphasis"
    },
    {
      "id": "in_meeting-to-restarting",
      "from": "in_meeting",
      "to": "restarting",
      "label": "no heartbeat 30 s",
      "variant": "dashed"
    },
    {
      "id": "restarting-to-in_meeting",
      "from": "restarting",
      "to": "in_meeting",
      "label": "rejoined",
      "variant": "emphasis"
    },
    {
      "id": "in_meeting-to-left_by_member",
      "from": "in_meeting",
      "to": "left_by_member",
      "label": "member leaves",
      "variant": "security"
    },
    {
      "id": "in_meeting-to-failed",
      "from": "in_meeting",
      "to": "failed",
      "label": "any state",
      "variant": "security"
    },
    {
      "id": "leaving-to-uploading",
      "from": "leaving",
      "to": "uploading"
    }
  ],
  "cards": []
}
