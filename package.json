{
  "private": true,
  "packageManager": "bun@1.4.3",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:worker": "bun build packages/worker/src/cli.ts --target=node --outdir packages/worker/dist --external playwright --external sharp --external zxing-wasm",
    "diagrams": "bun scripts/diagram-svg.ts",
    "graph": "graphify update .",
    "image:worker": "sh scripts/build-worker-image.sh",
    "lint": "prettier --check .",
    "lint:fix": "prettier --write .",
    "prepare": "husky",
    "test": "bun test --pass-with-no-tests",
    "tm-pipeline": "bun packages/pipeline/src/cli.ts",
    "tm-worker": "node packages/worker/dist/cli.js",
    "typecheck": "tsc && bun --filter '@tm/*' typecheck"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/bun": "^1.4.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "playwright": "1.64.1",
    "prettier": "^3.9.9",
    "typescript": "6.0.3"
  }
}
